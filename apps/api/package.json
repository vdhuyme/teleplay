{
  "name": "@teleplay/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@teleplay/core": "workspace:*",
    "@teleplay/youtube": "workspace:*",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:db",
    "express": "^5.2.1",
    "express-zod-safe": "^3.2.1",
    "grammy": "catalog:",
    "mysql2": "catalog:db",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "socket.io": "catalog:realtime",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:db",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
