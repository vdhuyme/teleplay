{
  "name": "teleplay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm --parallel -r run build",
    "dev": "pnpm --parallel -r run dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json,md,yml,yaml}\"",
    "typecheck": "pnpm --parallel -r run typecheck"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=22"
  }
}
